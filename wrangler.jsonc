{
  // Deploys this app to https://davidwhite.app/battlefield-fence-quote/ on Cloudflare Workers.
  // Cloudflare rebuilds and redeploys automatically on every push to main.
  "name": "battlefield-fence-quote",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "routes": [
    { "pattern": "davidwhite.app/battlefield-fence-quote*", "zone_name": "davidwhite.app" }
  ],
  "assets": {
    "directory": ".",
    "base_path": "/battlefield-fence-quote"
  }
}
